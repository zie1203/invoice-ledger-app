# Copy this file to .env and fill in your Turso database credentials.
# Get these by creating a free account at https://turso.tech, then:
#   turso db create invoice-ledger
#   turso db show invoice-ledger --url
#   turso db tokens create invoice-ledger
#
# Used by both `npm start` (local dev) and the Vercel deployment. On Vercel,
# set these same two values as Environment Variables in the project's
# Settings instead of using this file (this file is only for local use, and
# is not committed to git).

TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here
